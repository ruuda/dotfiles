{
  // Turn off AI stuff that I don't need.
  "cli_default_open_behavior": "existing_window",
  "tab_size": 2,
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "disable_ai": true,

  "theme": "One Dark",
  "vim_mode": true,
  "helix_mode": false,

  "wrap_guides": [80, 100],
  "preferred_line_length": 80,

  "ui_font_size": 16,
  "ui_font_family": "Cantarell",
  "buffer_font_size": 14,
  "buffer_font_family": "Intel One Mono",

  "autosave": "on_focus_change",
  "format_on_save": "off",
  "remove_trailing_whitespace_on_save": true,
  "soft_wrap": "none",

  "tabs": {
    "git_status": true,
  },

  "git": {
    "inline_blame": {
      "enabled": false
    }
  },

  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },

  "languages": {
    "HTML": {
      "jsx_tag_auto_close": {
        "enabled": false
      },
      "use_autoclose": false
    },
    "Rust": {
      "tab_size": 4
    },
    "Python": {
      // Disable stuff that runs untrusted javascript outside of a browser, and
      // creates weird .ropeproject directories that I never consented to.
      // See also https://github.com/zed-industries/zed/discussions/21163#discussioncomment-11373808.
      "language_servers": ["!pylsp"]
    }
  }
}
